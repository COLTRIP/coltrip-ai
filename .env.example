# mock | real  (real은 아직 미구현, app/data/loader.py의 RealDataLoader를 채운 후 사용)
DATA_SOURCE=mock

# 아래는 실제 데이터 연동 시 채우면 됩니다. mock 모드에서는 비어 있어도 무방합니다.
TOUR_API_KEY=
WEATHER_API_KEY=
# Kakao Local API는 사용하지 않음 (좌표 정제는 백엔드가 네이버 NCP로 전담)
# 감성 맥락 매칭은 로컬 임베딩 모델을 사용하므로 API 키가 필요 없음

# Nudge Engine 트리거 임계값 (고요 지수가 이 값보다 낮으면 대체 장소 추천)
QUIET_INDEX_ALERT_THRESHOLD=40
